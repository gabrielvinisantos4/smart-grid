# Porta da API (em produção a API também serve o frontend compilado)
PORT=3001

# Caminho do banco SQLite e da pasta de uploads
DATABASE_PATH=./data/studio.db
UPLOADS_DIR=./data/uploads

# Conta proprietária criada no primeiro boot (role: owner).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e exibida UMA vez no console.
ADMIN_EMAIL=owner@studio.com
ADMIN_PASSWORD=

# Origem pública do site (usada na verificação de Origin contra CSRF). Ex.: https://seudominio.com.br
# Em dev pode ficar vazio.
PUBLIC_ORIGIN=

# Defina como "true" quando o site estiver atrás de HTTPS + proxy reverso (cookies Secure + trust proxy)
COOKIE_SECURE=false
TRUST_PROXY=false
