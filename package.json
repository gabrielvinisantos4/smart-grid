{
  "name": "studio-orcamento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Landing page de orçamento personalizado + painel administrativo para agência de Social Media e Produção Audiovisual.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,white \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist-server/server/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --import tsx server/**/*.test.ts",
    "build:demo": "tsx scripts/export-demo.ts && VITE_DEMO=1 vite build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
